// server/prisma/schema.prisma

// Connection pooling and retry configuration
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["tracing"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Use a direct connection for migrations (Supabase/pgbouncer compatibility)
  directUrl = env("DIRECT_URL")
}

model User {
  id          String   @id @default(cuid())
  firebaseUid String   @unique
  email       String?  @unique
  phoneNumber String?  @unique
  displayName String?
  photoURL    String?
  country     String? // Country name
  countryCode String? // ISO 3166-1 alpha-2 code (e.g., "US", "GB")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Profile stats
  totalDistance Float @default(0)
  totalTime     Int   @default(0) // in seconds
  topSpeed      Float @default(0)
  totalTrips    Int   @default(0)
  xp            Int   @default(0) // Experience points from achievements
  level         Int   @default(1) // User level based on XP

  // Push notifications
  expoPushToken String? // Expo push token for notifications

  // Relationships
  journeys           Journey[]
  journeyInstances   JourneyInstance[]
  photos             Photo[]
  groupMemberships   GroupMember[]
  createdGroups      Group[]                @relation("GroupCreator")
  rideEvents         RideEvent[]
  achievements       UserAchievement[]
  streak             UserStreak?
  vehicles           Vehicle[]
  rides              Ride[]
  groupRidesLed      GroupRide[]            @relation("GroupRideLeader")
  groupRideParts     GroupRideParticipant[]
  groupMessages      GroupMessage[]
  vehicleServiceLogs VehicleServiceLog[]
  stats              UserStats?
  xpLedger           XpLedger[]
  rideAchievements   RideAchievement[]

  @@map("users")
}

model Vehicle {
  id        String   @id @default(cuid())
  userId    String
  name      String // e.g. "My Kawasaki"
  make      String // e.g. "Kawasaki"
  model     String // e.g. "Z900"
  year      Int? // e.g. 2022
  color     String? // e.g. "Metallic Blue"
  type      String   @default("motorcycle") // car | bike | motorcycle | scooter | truck | van
  photoURL  String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  journeys    Journey[]           @relation("GarageVehicleJourneys")
  serviceLogs VehicleServiceLog[]

  @@index([userId])
  @@index([userId, isDefault])
  @@map("vehicles")
}

model Journey {
  id        String        @id @default(cuid())
  userId    String
  title     String?
  startTime DateTime
  endTime   DateTime?
  status    JourneyStatus @default(ACTIVE)

  // Journey stats
  totalDistance Float @default(0)
  totalTime     Int   @default(0) // in seconds
  avgSpeed      Float @default(0)
  topSpeed      Float @default(0)

  // Route data
  startLatitude  Float
  startLongitude Float
  endLatitude    Float?
  endLongitude   Float?
  routePoints    Json? // Array of GPS coordinates

  // Metadata
  vehicle     String? // bike, car, truck, etc.
  weatherData Json?
  customTitle String?
  isHidden    Boolean   @default(false)
  hiddenAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Group journey (deprecated - use GroupJourney instead)
  groupId String?

  // Vehicle used for this journey (snapshot of garage vehicle at time of ride)
  vehicleId   String? // FK to Vehicle (nullable — legacy journeys won't have this)
  vehicleName String? // denormalised snapshot so vehicle deletion doesn't lose history

  // Relationships
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  group         Group?            @relation(fields: [groupId], references: [id])
  garageVehicle Vehicle?          @relation("GarageVehicleJourneys", fields: [vehicleId], references: [id], onDelete: SetNull)
  photos        Photo[]
  reminders     JourneyReminder[]

  @@index([userId, status, endTime])
  @@index([userId, status, startTime])
  @@index([userId])
  @@index([status])
  @@index([startTime])
  @@index([endTime])
  @@map("journeys")
}

model GroupJourney {
  id          String  @id @default(cuid())
  groupId     String
  creatorId   String
  title       String
  description String?

  // Journey configuration
  startLatitude  Float
  startLongitude Float
  endLatitude    Float?
  endLongitude   Float?
  routePoints    Json? // Shared route waypoints

  // Journey state
  status      GroupJourneyStatus @default(ACTIVE)
  startedAt   DateTime           @default(now())
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  group     Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  instances JourneyInstance[]
  events    RideEvent[]

  @@index([groupId])
  @@index([creatorId])
  @@index([status])
  @@map("group_journeys")
}

model JourneyInstance {
  id             String @id @default(cuid())
  groupJourneyId String
  userId         String

  // Individual progress
  status    JourneyStatus @default(ACTIVE)
  startTime DateTime      @default(now())
  endTime   DateTime?

  // Stats
  totalDistance Float @default(0)
  totalTime     Int   @default(0) // in seconds
  avgSpeed      Float @default(0)
  topSpeed      Float @default(0)

  // Current location
  currentLatitude    Float?
  currentLongitude   Float?
  lastLocationUpdate DateTime?

  // Route tracking
  routePoints Json? // Individual GPS trail

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  groupJourney GroupJourney   @relation(fields: [groupJourneyId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos       JourneyPhoto[]
  events       RideEvent[]

  @@unique([groupJourneyId, userId])
  @@index([userId])
  @@index([status])
  @@map("journey_instances")
}

model JourneyPhoto {
  id         String @id @default(cuid())
  instanceId String
  userId     String

  // File info
  filename     String
  originalName String?
  firebasePath String
  mimeType     String
  fileSize     Int

  // Photo metadata
  latitude  Float?
  longitude Float?
  takenAt   DateTime

  // Capture stats (rider stats at time of photo)
  captureSpeed    Float? // km/h at time of capture
  captureDistance Float? // total distance covered at capture time (km)
  captureHeading  Float? // heading/bearing at capture

  createdAt DateTime @default(now())

  // Relationships
  instance JourneyInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId])
  @@index([userId])
  @@map("journey_photos")
}

model Photo {
  id        String  @id @default(cuid())
  userId    String
  journeyId String?

  // File info
  filename     String
  originalName String?
  firebasePath String // Path in Firebase Storage
  mimeType     String
  fileSize     Int

  // Photo metadata
  latitude   Float?
  longitude  Float?
  takenAt    DateTime
  deviceInfo Json?

  // Processing
  thumbnailPath String?
  isProcessed   Boolean @default(false)

  // Capture stats (rider stats at time of photo)
  captureSpeed    Float? // km/h at time of capture
  captureDistance Float? // total distance covered at capture time (km)
  captureHeading  Float? // heading/bearing at capture

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  journey Journey? @relation(fields: [journeyId], references: [id], onDelete: SetNull)

  @@index([userId, takenAt])
  @@index([userId])
  @@index([takenAt])
  @@map("photos")
}

model Group {
  id            String  @id @default(cuid())
  name          String
  description   String?
  code          String  @unique // Join code
  creatorId     String
  isActive      Boolean @default(true)
  maxMembers    Int     @default(10)
  coverPhotoURL String? // Group cover photo

  // Group settings
  allowLocationSharing Boolean @default(true)
  isPrivate            Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  creator       User           @relation("GroupCreator", fields: [creatorId], references: [id])
  members       GroupMember[]
  journeys      Journey[]
  groupJourneys GroupJourney[]
  crewRides     GroupRide[]    @relation("CrewRides")
  messages      GroupMessage[]
  // Not a direct relation, events are tied to GroupJourney

  @@index([creatorId])
  @@index([isActive])
  @@map("groups")
}

model RideEvent {
  id             String  @id @default(cuid())
  groupJourneyId String
  instanceId     String?
  userId         String

  type      RideEventType
  message   String?
  latitude  Float?
  longitude Float?
  mediaUrl  String?
  data      Json?

  // Capture stats (for PHOTO events)
  captureSpeed    Float? // km/h at time of capture
  captureDistance Float? // total distance covered at capture time (km)

  createdAt DateTime @default(now())

  // Relations
  groupJourney GroupJourney     @relation(fields: [groupJourneyId], references: [id], onDelete: Cascade)
  instance     JourneyInstance? @relation(fields: [instanceId], references: [id], onDelete: SetNull)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([groupJourneyId])
  @@index([instanceId])
  @@index([userId])
  @@index([type])
  @@map("ride_events")
}

model GroupMember {
  id       String    @id @default(cuid())
  userId   String
  groupId  String
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  // Real-time tracking
  lastLatitude     Float?
  lastLongitude    Float?
  lastSeen         DateTime?
  isLocationShared Boolean   @default(false)

  // Relationships
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([userId])
  @@index([groupId])
  @@map("group_members")
}

// Journey Reminder model for tracking sent notifications
model JourneyReminder {
  id        String   @id @default(cuid())
  journeyId String
  userId    String
  type      String // "3_DAYS", "2_DAYS", "1_DAY", "D_DAY", "READY"
  sentAt    DateTime @default(now())

  journey Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@unique([journeyId, type])
  @@index([journeyId])
  @@map("journey_reminders")
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())
  xpAwarded     Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@map("user_achievements")
}

model UserStreak {
  id            String    @id @default(cuid())
  userId        String    @unique
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastRideDate  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_streaks")
}

// Enums
enum JourneyStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  PLANNED
  READY_TO_START // Journey scheduled time has arrived
}

enum GroupJourneyStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum GroupRole {
  CREATOR
  ADMIN
  MEMBER
}

enum RideEventType {
  MESSAGE
  PHOTO
  CHECKPOINT
  STATUS
  EMERGENCY
  CUSTOM
}

// ---------------------------------------------------------------------------
// v2 ride engine. Independent of the legacy Journey/JourneyInstance tables:
// v2 never reads or writes them (only the one-off backfill reads them).
// Ids are generated on the device so every write can be retried safely.
// ---------------------------------------------------------------------------

enum RideStatus {
  RECORDING
  PAUSED
  ENDED // device stopped recording; stats not yet credited
  FINALIZED // stats computed and credited to the user exactly once
  DELETED // removed and reversed
}

enum RideLifecycleType {
  START
  PAUSE
  RESUME
  END
}

model Ride {
  id          String     @id // client-generated UUID
  userId      String
  vehicleId   String?
  groupRideId String? // the group ride this solo-owned ride belongs to, if any
  title       String?
  status      RideStatus @default(RECORDING)
  startedAt   DateTime
  endedAt     DateTime?
  timezone    String? // IANA zone of the rider, used for night/streak rules

  // Authoritative stats, always computed by @wayfarian/ride-core on the server.
  distanceM    Float @default(0)
  movingTimeS  Int   @default(0)
  elapsedTimeS Int   @default(0)
  topSpeedMps  Float @default(0)
  avgSpeedMps  Float @default(0)
  pointCount   Int   @default(0)
  statsVersion Int   @default(1)

  finalizedAt DateTime?
  deletedAt   DateTime?

  // Backfill from the legacy tables
  legacyJourneyId String? @unique
  isLegacy        Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupRide GroupRide?           @relation(fields: [groupRideId], references: [id], onDelete: SetNull)
  points    RidePoint[]
  events    RideLifecycleEvent[]
  photos    RidePhoto[]

  @@index([groupRideId])
  @@index([userId, startedAt])
  @@index([userId, status])
  @@index([status, updatedAt])
  @@map("rides")
}

model RidePoint {
  rideId     String
  seq        Int // device-assigned, strictly increasing per ride; the dedupe key
  segment    Int // 0 at start, +1 on each resume; nothing is counted across segments
  lat        Float
  lng        Float
  recordedAt DateTime // device clock
  accuracy   Float?

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@id([rideId, seq])
  @@index([rideId, segment, recordedAt])
  @@map("ride_points")
}

model RideLifecycleEvent {
  id     String            @id // client-generated UUID
  rideId String
  type   RideLifecycleType
  at     DateTime // device clock

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@index([rideId, at])
  @@map("ride_lifecycle_events")
}

// A group ride is only membership, a leader, an optional destination and a lifecycle.
// Every rider records an ordinary Ride (Ride.groupRideId) and the group summary is computed
// from those finalized rides on read, so there is no second copy of any stat to drift.
enum GroupRideStatus {
  PLANNED
  ACTIVE
  ENDED
  CANCELLED
}

enum GroupRideRole {
  LEADER
  MEMBER
}

model GroupRide {
  id              String          @id // client-generated UUID
  leaderId        String
  title           String
  code            String          @unique // short invite code
  status          GroupRideStatus @default(PLANNED)
  maxParticipants Int             @default(20)
  destinationName String?
  destinationLat  Float?
  destinationLng  Float?
  scheduledAt     DateTime?
  startedAt       DateTime?
  endedAt         DateTime?
  // Set when the ride belongs to a crew (a persistent group); null for a one-off group ride.
  crewId          String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  leader       User                   @relation("GroupRideLeader", fields: [leaderId], references: [id], onDelete: Cascade)
  crew         Group?                 @relation("CrewRides", fields: [crewId], references: [id], onDelete: SetNull)
  participants GroupRideParticipant[]
  rides        Ride[]

  @@index([leaderId])
  @@index([status, updatedAt])
  @@index([crewId, status])
  @@map("group_rides")
}

// A message in a crew's activity feed.
model GroupMessage {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  body      String
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
  @@map("group_messages")
}

model GroupRideParticipant {
  id          String        @id @default(cuid())
  groupRideId String
  userId      String
  role        GroupRideRole @default(MEMBER)
  joinedAt    DateTime      @default(now())
  leftAt      DateTime? // null while the rider is in the group

  groupRide GroupRide @relation(fields: [groupRideId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupRideId, userId])
  @@index([userId, leftAt])
  @@map("group_ride_participants")
}

// A photo taken during a ride. The id is generated on the device so the upload can be retried.
model RidePhoto {
  id        String   @id // client-generated UUID
  rideId    String
  userId    String
  path      String // storage path or full URL of the image
  thumbPath String
  takenAt   DateTime
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@index([rideId, takenAt])
  @@index([userId])
  @@map("ride_photos")
}

// A service the rider did on a vehicle. The odometer is the distance ridden on it in Wayfarian at
// that moment, so "km to the next service" is derived from rides and never drifts.
model VehicleServiceLog {
  id         String   @id // client-generated UUID
  userId     String
  vehicleId  String
  kind       String   @default("service") // service | oil | tyres | chain | other
  doneAt     DateTime
  odometerM  Float
  intervalKm Int      @default(2500)
  notes      String?
  createdAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, doneAt])
  @@index([userId])
  @@map("vehicle_service_logs")
}

// Running totals, changed only inside RideService.finalize / reverse.
model UserStats {
  userId       String   @id
  distanceM    Float    @default(0)
  movingTimeS  Int      @default(0)
  elapsedTimeS Int      @default(0)
  topSpeedMps  Float    @default(0)
  rides        Int      @default(0)
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_stats")
}

// Append-only. The unique (userId, source) makes awarding XP idempotent.
model XpLedger {
  id        String   @id @default(cuid())
  userId    String
  source    String // e.g. "ride:<rideId>"
  amount    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source])
  @@index([userId, createdAt])
  @@map("xp_ledger")
}

// Achievements earned through the v2 engine. Unique per (user, achievement) so
// awarding is idempotent; the XP itself lives in xp_ledger as "achievement:<id>".
model RideAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  rideId        String? // the ride that tipped it over
  xpAwarded     Int
  earnedAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId, earnedAt])
  @@map("ride_achievements")
}
